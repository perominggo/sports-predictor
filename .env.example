# =============================================================================
# CONFIGURACIÓN DEL PROVEEDOR LLM (RAG)
# =============================================================================
# Opciones válidas para LLM_PROVIDER: "openai" o "gemini"
LLM_PROVIDER=gemini

# Clave de API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Clave de API de Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR Y SCRAPER
# =============================================================================
HOST=0.0.0.0
PORT=8000
PLAYWRIGHT_HEADLESS=true
SCRAPER_TIMEOUT_MS=25000
